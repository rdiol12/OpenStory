+# The Darwin symbol printer above does not describe ELF archives.
+ifeq ($(call isTargetOs, bsd), true)
+define GetSymbols
+  $(NM) $(NMFLAGS) --defined-only --extern-only --format=posix $$($1_TARGET) | \
+      $(AWK) '$$$$2 ~ /^[TW]$$$$/ {print $$$$1}' > \
+      $$(@D)/$$(basename $$(@F)).symbols
+endef
+endif
